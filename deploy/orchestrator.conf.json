  ],
  "PreFailoverProcesses": [
    "echo 'Pre-failover for {failureCluster}' >> /var/log/orchestrator/failover.log"
  ],
  "PostMasterFailoverProcesses": [
    "/etc/orchestrator/hooks/update-proxysql.sh",
    "echo 'Master failover completed: {successorHost}' >> /var/log/orchestrator/failover.log"
  ],
  "PostIntermediateMasterFailoverProcesses": [],
  "PostFailoverProcesses": [
    "echo 'Failover done for {failureCluster}' >> /var/log/orchestrator/failover.log"
  ],
  "PostUnsuccessfulFailoverProcesses": [],
  "PostMasterTakeProcesses": [],
